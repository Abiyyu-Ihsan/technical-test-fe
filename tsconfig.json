{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      
      "@styles/*": [
        "./styles/*"
      ],
      "@shadcn/*": ["./shadcn/*"],

      "@component/*": [
        "./component/*"
      ],
      "@icons/*": [
        "./component/icons/*"
      ],
      "@layouts/*": [
        "./component/layouts/*"
      ],
      "@screens/*": [
        "./component/screens/*"
      ],
      "@widgets/*": [
        "./component/widgets/*"
      ],
      "@libs/*": [
        "./libs/*"
      ],
      "@data/*": [
        "./libs/data/*"
      ],
      "@hooks/*": [
        "./libs/hooks/*"
      ],
      "@services/*": [
        "./libs/services/*"
      ],
      "@types/*": [
        "./libs/types/*"
      ],
      "@utils/*": [
        "./libs/utils/*"
      ],
      "@validations/*": [
        "./libs/validations/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
